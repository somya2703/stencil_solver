# Dockerfile.dev — full development image with CUDA toolkit, Nsight tools,
#                  MPI, NCCL, and all build dependencies.
#
# Build:
#   docker build -f infra/docker/Dockerfile.dev -t stencil-solver:dev .
# Run:
#   docker run --gpus all --rm -it -v $(pwd):/workspace stencil-solver:dev

ARG CUDA_VERSION=12.4.1
ARG UBUNTU_VERSION=22.04
FROM nvcr.io/nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION}

LABEL org.opencontainers.image.title="stencil-solver-dev"
LABEL org.opencontainers.image.description="CUDA stencil solver — full dev environment"

# ── System packages ───────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build toolchain
    ca-certificates gpg curl \
    && curl -fsSL https://apt.kitware.com/keys/kitware-archive-latest.asc \
       | gpg --dearmor -o /usr/share/keyrings/kitware-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/kitware-archive-keyring.gpg] \
       https://apt.kitware.com/ubuntu/ jammy main" \
       > /etc/apt/sources.list.d/kitware.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    cmake \  
    ninja-build \
    ccache \
    clang-format-15 \
    clang-tidy-15 \
    # MPI
    libopenmpi-dev \
    openmpi-bin \
    # Python (for plot_results.py and conan)
    python3 \
    python3-pip \
    python3-venv \
    # Utilities
    git \
    curl \
    wget \
    vim \
    gdb \
    valgrind \
    lcov \
    jq \
    && rm -rf /var/lib/apt/lists/*

# After the apt-get block, fetch NVTX3 headers
RUN mkdir -p /usr/local/cuda/include/nvtx3 \
    && curl -fsSL https://raw.githubusercontent.com/NVIDIA/NVTX/v3.1.0/c/include/nvtx3/nvtx3.hpp \
       -o /usr/local/cuda/include/nvtx3/nvtx3.hpp

    # Pin cmake to 3.26+ if distro ships older version
RUN cmake --version | grep -q "3\.[2-9][0-9]" || ( \
    pip3 install --quiet cmake && \
    ln -sf $(python3 -m site --user-base)/bin/cmake /usr/local/bin/cmake \
)

# ── NCCL (from NVIDIA repo) ───────────────────────────────────────────────────
ARG NCCL_VERSION=2.20.5
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnccl2=${NCCL_VERSION}-1+cuda$(echo ${CUDA_VERSION} | cut -d. -f1,2) \
    libnccl-dev=${NCCL_VERSION}-1+cuda$(echo ${CUDA_VERSION} | cut -d. -f1,2) \
    && rm -rf /var/lib/apt/lists/* \
    || echo "NCCL apt install skipped (version mismatch) — install manually if needed"

# ── Python tools (Conan, matplotlib, numpy) ───────────────────────────────────
COPY conanfile.txt /tmp/conanfile.txt
RUN pip3 install --no-cache-dir \
    "conan>=2.0" \
    matplotlib \
    numpy \
    pandas \
    && conan profile detect --force

# ── Nsight Compute CLI (ncu) — already in CUDA devel image, verify ────────────
RUN ncu --version || echo "WARNING: ncu not found in PATH"
RUN nsys --version || echo "WARNING: nsys not found in PATH"

# ── ccache config ─────────────────────────────────────────────────────────────
ENV CCACHE_DIR=/ccache
ENV CCACHE_MAXSIZE=5G
RUN mkdir -p /ccache

# ── Build environment ─────────────────────────────────────────────────────────
WORKDIR /workspace

ENV CMAKE_GENERATOR=Ninja
ENV CMAKE_BUILD_TYPE=Release

# Convenience aliases
RUN echo 'alias ll="ls -la"' >> /root/.bashrc && \
    echo 'alias build="cmake --build build --parallel $(nproc)"' >> /root/.bashrc && \
    echo 'alias configure="cmake -B build -S . -DSTENCIL_BUILD_TESTS=ON"' >> /root/.bashrc

CMD ["/bin/bash"]
